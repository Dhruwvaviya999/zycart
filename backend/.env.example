# Server
PORT=5000
NODE_ENV=development

# Database - required, no default is assumed
MONGODB_URI=

# Observability (Phase 16) - none of this is a credential.
#
# LOG_LEVEL   debug | info | warn | error. Default info. `debug` adds per-request
#             health checks, search text and provider detail. It is not a
#             secret-revealing mode: redaction runs identically at every level.
# LOG_FORMAT  json | text. Left blank on purpose - JSON in production, where
#             something parses it; aligned text elsewhere, where a person reads it.
# SLOW_REQUEST_MS
#             Above this, a completed request is logged at WARN rather than INFO.
#             The request still succeeded; the duration is what is being reported.
LOG_LEVEL=info
LOG_FORMAT=
SLOW_REQUEST_MS=1000

# Origin allowed by CORS (the frontend)
CLIENT_URL=http://localhost:3000

# Authentication - required. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay - all three, or none of them.
#
# Leaving all three blank runs ZyCart cash-on-delivery only; online payment is
# then not offered at checkout, and the server says so at startup.
# Setting only some of them is refused at startup, because a key with no secret
# would create payments it could never verify.
#
# Dashboard -> Account & Settings -> API Keys (use Test Mode in development).
# NEVER commit real values. Test keys begin rzp_test_, live keys rzp_live_ -
# a live key outside NODE_ENV=production is rejected, and vice versa.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard -> Account & Settings -> Webhooks -> the secret you set on the
# webhook. This is a DIFFERENT secret from RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# ZyCart AI (Phase 10) - all server-only.
#
# Leaving AI_API_KEY blank runs ZyCart with no shopping assistant: the storefront,
# cart, checkout, orders and account all work exactly as before, and the server
# says at startup that the assistant is unavailable. It is a supported state, not
# a broken one.
#
# NEVER expose any of these to the browser. There is no NEXT_PUBLIC_ counterpart
# to AI_API_KEY and there must never be one - the key is used only by Express.
AI_ENABLED=true

# anthropic | mock
#
# "mock" answers from a fixed script. It exists for tests and for working on the
# UI without credentials, and it is refused when NODE_ENV=production - a scripted
# assistant that looks real is worse than an honestly unavailable one.
AI_PROVIDER=anthropic

# console.anthropic.com -> API keys. Server-only; never commit a real value.
AI_API_KEY=

AI_MODEL=claude-opus-5

# Per model call, in milliseconds. The whole request, tool rounds included, has
# its own shorter-lived deadline in src/config/ai.ts.
AI_TIMEOUT_MS=30000

# Chat requests per minute, counted per IP for guests and per account otherwise.
AI_RATE_LIMIT_GUEST=10
AI_RATE_LIMIT_USER=30

# Transactional email (Phase 14) - all server-only.
#
# ZyCart emails a customer about four things: their order shipped, their order
# was delivered, their return was approved, their refund completed. Nothing
# else, and there is no marketing communication of any kind.
#
# NEVER expose any of these to the browser. Mail leaves from Express and nowhere
# else, so there is no NEXT_PUBLIC_ counterpart to SMTP_PASSWORD and there must
# never be one.

# mock | smtp
#
# "mock" renders and records every message and delivers nothing. It is the
# default, it is what the test suite and the verification script require, and it
# lets a contributor without a mail server click through the whole admin console
# and read real generated mail.
#
# It is allowed in production, unlike AI_PROVIDER=mock, but the server says so
# loudly at startup and every delivery record and admin screen reports the
# transport as "mock" - so nothing can be mistaken for a real send.
EMAIL_PROVIDER=mock

# The display name on the From header. Never a person's name.
EMAIL_FROM_NAME=ZyCart

# Required once EMAIL_PROVIDER=smtp, and deliberately given no default: a
# hardcoded fallback is how a developer's own mailbox ends up in the From header
# of production mail.
EMAIL_FROM_ADDRESS=

# Where replies go. Leave blank unless the store has a real, monitored support
# mailbox - a Reply-To pointing at an unread inbox invites a customer to answer
# a message nobody will read. When it is set, it also appears in the footer of
# every transactional email.
EMAIL_REPLY_TO=

# The mail server. Required as a set once EMAIL_PROVIDER=smtp: a half-configured
# transport is refused at startup rather than failing one message at a time.
#
# SMTP rather than a vendor SDK because every provider speaks it - Amazon SES,
# Postmark, Mailgun, Brevo, Zoho or your own Postfix all configure these five
# and nothing in the code changes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# true for implicit TLS on connect (port 465). Port 587 upgrades with STARTTLS,
# so leave this false there.
SMTP_SECURE=false

# Note: there is no APP_URL. Links in transactional email are built from
# CLIENT_URL above, which is the same fact about a deployment - a second
# variable would only create a pair that can disagree. CLIENT_URL must be an
# absolute http(s) address, and it is validated at startup for exactly this
# reason: a malformed value produces broken links in mail nobody can recall.
