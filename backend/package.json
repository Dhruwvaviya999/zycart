{
  "name": "zycart-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + TypeScript API for the Zycart AI-powered e-commerce application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "tsx src/utils/seed.ts",
    "migrate:phase7": "tsx src/utils/migrate-phase7.ts",
    "migrate:phase8": "tsx src/utils/migrate-phase8.ts",
    "migrate:phase12": "tsx src/utils/migrate-phase12.ts",
    "migrate:phase13": "tsx src/utils/migrate-phase13.ts",
    "migrate:phase20": "tsx src/utils/migrate-phase20.ts",
    "inventory:verify": "tsx src/utils/verify-inventory.ts",
    "returns:verify": "tsx src/utils/verify-returns.ts",
    "notifications:verify": "tsx src/utils/verify-notifications.ts",
    "notifications:drain": "tsx src/utils/drain-notifications.ts",
    "reminders:send": "tsx src/utils/send-reminders.ts",
    "alerts:send": "tsx src/utils/send-alerts.ts",
    "payments:verify": "tsx src/utils/verify-payments.ts",
    "health:verify": "tsx src/utils/verify-health.ts",
    "smoke:deploy": "tsx src/utils/smoke-deploy.ts",
    "seed:reviews": "tsx src/utils/seed-reviews.ts",
    "seed:orders": "tsx src/utils/seed-orders.ts",
    "seed:products": "tsx scripts/seed-products/index.ts",
    "make-admin": "tsx src/utils/make-admin.ts",
    "clerk:import": "tsx src/utils/import-clerk-users.ts",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "ai:verify": "tsx src/utils/verify-ai.ts",
    "ai:eval": "tsx src/utils/eval-ai.ts",
    "discovery:verify": "tsx src/utils/verify-discovery.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clerk/express": "^2.1.77",
    "@google/genai": "^2.23.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.0.10",
    "openai": "^7.20.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
