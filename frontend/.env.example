# Base URL of the Zycart backend API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Razorpay publishable key id. Safe in the browser by design - Checkout needs
# it - and it must match RAZORPAY_KEY_ID on the backend.
#
# The key SECRET and the WEBHOOK SECRET must never appear in a NEXT_PUBLIC_
# variable, or in this file at all.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
