# Base URL of the Zycart backend API.
#
# Set it for local development, where Next runs on :3000 and Express on :5000
# and the call really is cross-origin.
#
# LEAVE IT UNSET ON VERCEL. There the storefront and the API are two services
# behind one domain, so an empty base makes every browser call same-origin:
# no preflight, and the session cookie stays first-party. Server components
# use the BACKEND_URL service binding instead, which Vercel injects itself -
# do not add BACKEND_URL to the project's environment variables by hand.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Razorpay publishable key id. Safe in the browser by design - Checkout needs
# it - and it must match RAZORPAY_KEY_ID on the backend.
#
# The key SECRET and the WEBHOOK SECRET must never appear in a NEXT_PUBLIC_
# variable, or in this file at all.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
